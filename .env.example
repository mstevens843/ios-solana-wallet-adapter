# Copy to `.env` (gitignored) and fill in real values. `scripts/iwa-env.sh`
# reads `.env` to bake secrets into on-device builds.
#
# WalletAdapterServiceConfiguration.fromEnvironment() reads these keys. RPC
# resolution order: SOLANA_RPC_URL -> HELIUS_RPC_URL -> public mainnet default.
# Set SOLANA_RPC_URL (not also HELIUS_RPC_URL) to route sign/send through Helius.

SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<your-helius-key>
WALLETCONNECT_PROJECT_ID=<your-walletconnect-project-id>

# Optional:
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<your-helius-key>
# JUP_API_URL=https://api.jup.ag
# JUP_API_KEY=<your-jupiter-key>
# JUP_FETCH_TIMEOUT_MS=8000
